# ============================================================================
# Corporate Narrative Consistency Engine - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=corporate_narrative_engine
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password

# Full database URL (alternative to individual settings)
# DATABASE_URL=postgresql://user:password@localhost:5432/corporate_narrative_engine

# ----------------------------------------------------------------------------
# API Keys - LLM Providers
# ----------------------------------------------------------------------------
# Anthropic Claude API (required for claim extraction)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API (optional, for embeddings alternative)
# OPENAI_API_KEY=sk-your-openai-key-here

# ----------------------------------------------------------------------------
# API Keys - News Sources
# ----------------------------------------------------------------------------
# NewsAPI.org (free tier: 100 requests/day)
# Get your key at: https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key-here

# GDELT API (no key required, but rate limits apply)
# No configuration needed

# ----------------------------------------------------------------------------
# API Keys - Market Data
# ----------------------------------------------------------------------------
# Alpha Vantage (optional, yfinance is default)
# Get your key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# ----------------------------------------------------------------------------
# SEC EDGAR Configuration
# ----------------------------------------------------------------------------
# Your email is required for SEC EDGAR API compliance
# SEC requires identification for all programmatic access
SEC_USER_AGENT=YourName your.email@example.com

# ----------------------------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------------------------
# HuggingFace token (optional, for gated models)
# HUGGINGFACE_TOKEN=hf_your_token_here

# Device for model inference (cuda, mps, cpu)
# Leave empty for auto-detection
TORCH_DEVICE=

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Number of workers for parallel processing
NUM_WORKERS=4

# Cache directory for downloaded models
CACHE_DIR=.cache

# ----------------------------------------------------------------------------
# Gradio Dashboard
# ----------------------------------------------------------------------------
# Server settings
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Enable/disable public sharing
GRADIO_SHARE=false

# Authentication (optional)
# GRADIO_USERNAME=admin
# GRADIO_PASSWORD=secure_password
